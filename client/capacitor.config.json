{
  "appId": "br.com.sirel.movizzquizz",
  "appName": "MovizzQuizz",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://quizz.sirel.com.br",
    "androidScheme": "https",
    "cleartext": false,
    "allowNavigation": [
      "quizz.sirel.com.br",
      "*.sirel.com.br"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1400,
      "launchAutoHide": true,
      "backgroundColor": "#070713",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#070713",
      "overlaysWebView": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_movizzquizz",
      "iconColor": "#6366F1"
    }
  }
}
