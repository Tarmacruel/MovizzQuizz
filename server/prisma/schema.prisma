generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Question {
  id         String   @id
  category   String
  difficulty String
  question   String
  options    Json
  answer     String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active])
  @@index([category, difficulty])
}

model Room {
  id             String         @id @default(cuid())
  code           String         @unique
  gameType       String         @default("quiz")
  status         String         @default("lobby")
  hostSocketId   String?
  settings       Json
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  players        Player[]
  sessions       GameSession[]
  stopRounds     StopRound[]
  stopCategories StopCategory[]
  matchSummaries PlayerMatchSummary[]

  @@index([gameType])
}

model Player {
  id          String       @id @default(cuid())
  roomId      String
  accountId   String?
  socketId    String
  name        String
  score       Int          @default(0)
  connected   Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  room        Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  account     PlayerAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  answers     GameAnswer[]
  stopAnswers StopAnswer[]

  @@unique([roomId, socketId])
  @@index([roomId])
  @@index([accountId])
}

model GameSession {
  id             String         @id @default(cuid())
  roomId         String
  gameType       String         @default("quiz")
  status         String         @default("playing")
  currentIndex   Int            @default(0)
  deck           Json
  settings       Json?
  history        Json?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  room           Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  answers        GameAnswer[]
  stopRounds     StopRound[]
  stopCategories StopCategory[]
  matchSummaries PlayerMatchSummary[]

  @@index([roomId])
  @@index([gameType])
  @@index([status])
}

model PlayerAccount {
  id          String                 @id @default(cuid())
  handle      String                 @unique
  displayName String
  pinHash     String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  sessions    PlayerAccountSession[]
  players     Player[]
  summaries   PlayerMatchSummary[]
}

model PlayerAccountSession {
  id         String        @id @default(cuid())
  accountId  String
  tokenHash  String        @unique
  createdAt  DateTime      @default(now())
  lastSeenAt DateTime      @default(now())
  expiresAt  DateTime
  account    PlayerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
}

model PlayerMatchSummary {
  id           String         @id @default(cuid())
  accountId    String
  sessionId    String?
  roomId       String?
  roomCode     String
  gameType     String
  matchName    String?
  status       String
  score        Int            @default(0)
  rank         Int?
  won          Boolean        @default(false)
  roundsPlayed Int            @default(0)
  playedAt     DateTime       @default(now())
  finishedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  account      PlayerAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  session      GameSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  room         Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([accountId, sessionId])
  @@index([accountId])
  @@index([gameType])
  @@index([finishedAt])
}

model GameAnswer {
  id             String      @id @default(cuid())
  sessionId      String
  playerId       String
  questionId     String?
  selectedOption String?
  correct        Boolean     @default(false)
  points         Int         @default(0)
  secondsLeft    Int?
  answeredAt     DateTime    @default(now())
  session        GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player         Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([playerId])
  @@index([questionId])
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AppSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StopRound {
  id                String       @id @default(cuid())
  roomId            String
  sessionId         String?
  roundNumber       Int
  letter            String
  status            String       @default("stop-playing")
  startedAt         DateTime?
  endedAt           DateTime?
  stoppedByPlayerId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  room              Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  session           GameSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  answers           StopAnswer[]

  @@index([roomId])
  @@index([sessionId])
  @@index([status])
}

model StopCategory {
  id        String       @id @default(cuid())
  roomId    String?
  sessionId String?
  name      String
  order     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  room      Room?        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  session   GameSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers   StopAnswer[]

  @@index([roomId])
  @@index([sessionId])
}

model StopAnswer {
  id               String       @id @default(cuid())
  roundId          String
  playerId         String
  categoryId       String
  answer           String
  normalizedAnswer String
  autoValid        Boolean      @default(false)
  hostValid        Boolean?
  unique           Boolean      @default(false)
  points           Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  round            StopRound    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  player           Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  category         StopCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([roundId])
  @@index([playerId])
  @@index([categoryId])
}
